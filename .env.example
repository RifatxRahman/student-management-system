# ==============================================================================
# স্কুল ম্যানেজমেন্ট সিস্টেম (SMS) - পরিবেশ ও সিক্রেট কনফিগারেশন (.env)
# এই ফাইলটি কপি করে '.env' নামে সংরক্ষণ করুন এবং প্রোডাকশন পাসওয়ার্ড দিন।
# ==============================================================================

# ডেটাবেজ সেটিংস (MySQL 8.4)
DB_NAME=sms_db
DB_USER=sms_user
DB_PASSWORD=SecureDbPass2026!
DB_ROOT_PASSWORD=RootSuperSecure2026!

# JWT অথেনটিকেশন সিক্রেট (কমপক্ষে ৩২ অক্ষরের শক্তিশালী সিক্রেট)
JWT_SECRET=4f8b9a1e7c3d2f0a5b6c8d9e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a

# প্রাথমিক অ্যাডমিন অ্যাকাউন্ট বুটস্ট্র্যাপ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecure2026!

# এসএমএস গেটওয়ে টোকেন (Greenweb বা BD Bulk SMS)
SMS_API_TOKEN=mock_sms_token_demo_12345

# ফ্রন্টএন্ড ওয়েব পোর্ট
WEB_PORT=80
